{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
  ],
  rangeStrategy: "pin",
  packageRules: [
    {
      description: "Group all build dependency updates together for easier review",
      groupName: "Build dependencies",
      matchFileNames: [
        "CMakeLists.txt",
        "pyproject.toml",
        "requirements.txt",
      ],
    },
  ],
  regexManagers: [
    {
      description:
        "lib3mf - version defined by LIB3MF_VERSION in lib3mf/CMakeLists.txt, used in git tag v${LIB3MF_VERSION} and wheel download URL",
      fileMatch: ["lib3mf/CMakeLists.txt"],
      matchStrings: ['LIB3MF_VERSION\\s+"(?<currentValue>[^"]+)"'],
      datasourceTemplate: "github-tags",
      depNameTemplate: "3MFConsortium/lib3mf",
      extractVersionTemplate: "^v(?<version>.*)$",
    },
    {
      description:
        "OCCT - versioned via git tag in checkout_git_tag (e.g. V7_8_1) in cadquery-ocp-novtk/CMakeLists.txt",
      fileMatch: ["cadquery-ocp-novtk/CMakeLists.txt"],
      matchStrings: [
        'checkout_git_tag\\([^)]*URL "https://github\\.com/Open-Cascade-SAS/OCCT\\.git"[^)]*TAG "(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: "github-tags",
      depNameTemplate: "Open-Cascade-SAS/OCCT",
      versioningTemplate: "regex:^V(?<major>\\d+)_(?<minor>\\d+)_(?<patch>\\d+)$",
    },
    {
      description:
        "pybind11 - versioned via git tag in checkout_git_tag (e.g. v3.0.4) in cadquery-ocp-novtk/CMakeLists.txt",
      fileMatch: ["cadquery-ocp-novtk/CMakeLists.txt"],
      matchStrings: [
        'checkout_git_tag\\([^)]*URL "https://github\\.com/pybind/pybind11\\.git"[^)]*TAG "(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: "github-tags",
      depNameTemplate: "pybind/pybind11",
      versioningTemplate: "loose",
    },
    {
      description:
        "OCP - versioned via download URL release tag (e.g. 7.8.1.2) in cadquery-ocp-novtk/CMakeLists.txt",
      fileMatch: ["cadquery-ocp-novtk/CMakeLists.txt"],
      matchStrings: [
        'download_url\\([^)]*URL "[^"]*/releases/download/(?<currentValue>[^/]+)/OCP_src_stubs_ubuntu-20\\.04\\.zip"',
      ],
      datasourceTemplate: "github-releases",
      depNameTemplate: "CadQuery/OCP",
      versioningTemplate: "loose",
    },
  ],
}

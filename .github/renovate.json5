{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard"
  ],
  "automerge": true,
  "automergeType": "branch",
  "schedule": [ "* * * * 0,6" ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [ "* * * * 0,6" ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/CMakeLists\\.txt$/"],
      "matchStrings": [
        "FetchContent_Declare\\(\\s*pybind11\\s*URL\\s*\"https:\\/\\/github\\.com\\/(?<packageName>pybind\\/pybind11)\\/archive\\/refs\\/tags\\/v(?<currentValue>[^\"]+)\\.zip\"",
        "FetchContent_Declare\\(\\s*lib3mf\\s*URL\\s*\"https:\\/\\/github\\.com\\/(?<packageName>3MFConsortium\\/lib3mf)\\/archive\\/refs\\/tags\\/v(?<currentValue>[^\"]+)\\.zip\"",
        "FetchContent_Declare\\(\\s*OCP\\s*URL\\s*\"https:\\/\\/github\\.com\\/(?<packageName>CadQuery\\/OCP)\\/releases\\/download\\/(?<currentValue>[^\\/]+)\\/(?<depName>[^\"]*)\""
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/CMakeLists\\.txt$/"],
      "matchStrings": [
        "FetchContent_Declare\\(\\s*rapidjson\\s*URL\\s*\"https:\\/\\/github\\.com\\/(?<packageName>Tencent\\/rapidjson)\\/archive\\/(?<currentValue>[a-f0-9]{40})\\.zip\""
      ],
      "datasourceTemplate": "git-refs",
      "versioningTemplate": "git"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/CMakeLists\\.txt$/"],
      "matchStrings": [
        "FetchContent_Declare\\(\\s*OpenCASCADE\\s*URL\\s*\"https:\\/\\/github\\.com\\/(?<packageName>Open-Cascade-SAS\\/OCCT)\\/archive\\/refs\\/tags\\/V(?<currentValue>[^\"]+)\\.zip\""
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/requirements\\.txt$/"],
      "matchStrings": [
        "pyodide-xbuildenv==(?<currentValue>[^ ]+)"
      ],
      "packageNameTemplate": "pyodide/pyodide",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    }
  ]
}

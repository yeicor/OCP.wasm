{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":disableDependencyDashboard"],
  "automerge": true,
  "automergeType": "branch",
  "schedule": ["* * * * 0,6"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* * * * 0,6"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/CMakeLists\\.txt$/"],
      "matchStrings": [
        "checkout_git_tag\\(.*?URL\\s*\"https:\\/\\/github\\.com\\/(?<packageName>[^\"]+?)\\.git\".*?TAG\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/CMakeLists\\.txt$/"],
      "matchStrings": [
        "checkout_git_tag\\(.*?URL\\s*\"https:\\/\\/github\\.com\\/(?<packageName>[^\"]+?)\\.git\".*?TAG\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "git-refs",
      "versioningTemplate": "git"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/CMakeLists\\.txt$/"],
      "matchStrings": [
        "download_url\\(.*?URL\\s*\"https:\\/\\/github\\.com\\/(?<packageName>CadQuery\\/OCP)\\/releases\\/download\\/(?<currentValue>[^\\/]+)\\/(?<depName>[^\"]+)\""
      ],
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/requirements\\.txt$/"],
      "matchStrings": ["pyodide-xbuildenv==(?<currentValue>[^\\s]+)"],
      "packageNameTemplate": "pyodide/pyodide",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    }
  ]
}
